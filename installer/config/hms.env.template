# HMS — install PostgreSQL yourself, then edit this file.

# --- Database (server PC only) ---
# Install PostgreSQL 16, set your postgres password, create database "hms".
# Example:  postgresql://postgres:postpass@127.0.0.1:5432/hms
DATABASE_URL=postgresql://postgres:postpass@127.0.0.1:5432/hms

# --- API ---
# Server PC:  leave BASE_URL as http://127.0.0.1:8010
# Client PC:  set BASE_URL to the server, e.g. http://192.168.1.10:8010
#             (installer prompts for this when you choose Client role)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010
BASE_URL=http://127.0.0.1:8010

# --- Application ---
APP_ENV=production
DEBUG=false
SEED_ON_STARTUP=true
SECRET_KEY=change-me-to-a-long-random-string-in-production

# --- Storage ---
REPORTS_OUTPUT_DIR=./data/storage/reports
DOCTORS_STORAGE_DIR=./data/storage/doctors
PATIENTS_STORAGE_DIR=./data/storage/patients

# --- Auto-update (checked every time you Start HMS / Start HMS Desktop) ---
# Copy only HMS-Update.zip into the SERVER updates folder — all PCs update on restart.
# Server PC: reads this local folder.
# Client PC: downloads the zip from the server over BASE_URL — no shared folder needed.
# UPDATE_PATH is only a fallback for old setups that still use \\SERVER\HMSUpdates.
UPDATE_PATH=D:\HMS\updates
